{
  "_comment": "The browser tests (frontend/e2e) run the API with these settings. Nothing here is secret: the database is a throwaway container, the payments are fake, and the API refuses the test payment provider in any other environment.",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5434;Database=furniture_e2e;Username=e2e;Password=e2e"
  },
  "FileStorage": {
    "BaseUrl": "http://localhost:5069/uploads",
    "Directory": "e2e-uploads"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5174"
  },
  "Payments": {
    "Provider": "Test",
    "CallbackUrl": "http://localhost:5069/api/payments/callback"
  },
  "Reconciliation": {
    "Enabled": false
  },
  "Jwt": {
    "SigningKey": "e2e-tests-signing-key-not-used-anywhere-else"
  },
  "AdminUser": {
    "Email": "admin@e2e.test",
    "Password": "E2eAdmin123"
  }
}
