{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "BaseUrl": "http://localhost:5068/uploads"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Payments": {
    "CallbackUrl": "http://localhost:5068/api/payments/callback"
  },
  "Iyzico": {
    "BaseUrl": "https://sandbox-api.iyzipay.com"
  },
  "Reconciliation": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "PendingPaymentTimeoutMinutes": 35,
    "CancellingTimeoutMinutes": 2
  },
  "Jwt": {
    "Issuer": "FurnitureEcommerce",
    "Audience": "FurnitureEcommerce",
    "ExpiryMinutes": 60
  }
}
